<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8" />
    <link rel="stylesheet" type="text/css" href="mystyle.css" />
	<title>Cat Breed Gallery</title>
</head>
<body>

	<h1>Cat Breed Gallery</h1>
    <div id="content">
        <div class="clsSelection">
            <form action="/" method="POST">
            <!-- loop through txt file imagelist.txt using readline-->
                {{#each data.arrayImg}}
                <input type="radio" id={{this.line}} name="selection" value={{this.line}}>
                <label for={{line}}>{{line}}</label><br>
                {{/each}}
                <input class="submit" type="submit" value="Submit"> 
            </form>
        </div>
        <div class="clsContent">
            <h1>{{data.curCat.cat}}</h1>
            <img src={{data.curCat.img}} alt={{data.curCat.cat}} class="border" border="25"/>
        </div>
    </div>
</body>
</html>
